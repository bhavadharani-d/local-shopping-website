{
  "kind": "collectionType",
  "collectionName": "orders",
  "info": {
    "singularName": "order",
    "pluralName": "orders",
    "displayName": "Order"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "tokenNumber": {
      "type": "integer",
      "unique": true
    },
    "items": {
      "type": "json",
      "required": true
    },
    "totalAmount": {
      "type": "decimal",
      "required": true
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "Received",
        "Accepted",
        "Preparing",
        "Ready",
        "Collected"
      ],
      "default": "Received"
    },
    "customerName": {
      "type": "string"
    },
    "customerPhone": {
      "type": "string"
    },
    "customerAddress": {
      "type": "text"
    },
    "orderType": {
      "type": "enumeration",
      "enum": [
        "Pickup"
      ],
      "default": "Pickup"
    },
    "shopName": {
      "type": "string"
    },
    "shop": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::shop.shop",
      "inversedBy": "orders"
    },
    "pickupTime": {
      "type": "datetime"
    },
    "orderNotes": {
      "type": "text"
    },
    "totalCost": {
      "type": "decimal",
      "default": 0
    },
    "totalProfit": {
      "type": "decimal",
      "default": 0
    }
  }
}
